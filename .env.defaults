# These environment variables will be used by default if you do not create any
# yourself in .env. This file should be safe to check into your version control
# system. Any custom values should go in .env and .env should *not* be checked
# into version control.

# Local Docker PostgreSQL defaults. Put secrets or machine-specific overrides in
# .env, which is intentionally ignored by Git.
DATABASE_URL=postgresql://personal_digital_team:personal_digital_team@127.0.0.1:5433/personal_digital_team?schema=public

# location of the test database for api service scenarios (defaults to ./.cedar/test.db if not set)
TEST_DATABASE_URL=postgresql://personal_digital_team:personal_digital_team@127.0.0.1:5433/personal_digital_team_test?schema=public

TASK_RUNTIME_API_URL=http://127.0.0.1:8901/graphql

# disables Prisma CLI update notifier
PRISMA_HIDE_UPDATE_MESSAGE=true

# Option to override the current environment's default api-side log level
# See: https://cedarjs.com/docs/logger for level options, defaults to "trace" otherwise.
# Most applications want "debug" or "info" during dev, "trace" when you have issues and "warn" in production.
# Ordered by how verbose they are: trace | debug | info | warn | error | silent
# LOG_LEVEL=debug
