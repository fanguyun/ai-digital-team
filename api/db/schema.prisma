// Don't forget to tell Prisma about your edits to this file using
// `yarn cedar prisma migrate dev` or `yarn cedar prisma db push`.
// `migrate` is like committing while `push` is for prototyping.
// Read more about both here:
// https://www.prisma.io/docs/orm/prisma-migrate

datasource db {
  provider = "postgresql"
}

// This specific combination of settings is the only way to make Prisma 7 work
// in both CJS and ESM Cedar apps.
// See https://github.com/cedarjs/cedar/pull/1761 for more info
generator client {
  provider               = "prisma-client"
  output                 = "./generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
}

enum TaskRunStatus {
  QUEUED
  RUNNING
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskRunStage {
  INTAKE
  PLANNING
  EXECUTION
  VERIFICATION
  DELIVERY
}

model TaskRun {
  id                String        @id @default(uuid()) @db.Uuid
  title             String        @db.VarChar(200)
  platform          String        @db.VarChar(80)
  externalReference String?       @db.VarChar(300)
  primaryAgent      String        @db.VarChar(160)
  status            TaskRunStatus @default(QUEUED)
  currentStage      TaskRunStage  @default(INTAKE)
  summary           String?       @db.VarChar(1000)
  version           Int           @default(1)
  startedAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  events            TaskEvent[]
  taskId            String?       @db.Uuid
  logPath           String?       @db.VarChar(300)
  pid               Int?
  mode              String        @default("auto") @db.VarChar(12)
  inputTokens       Int?
  outputTokens      Int?
  cachedTokens      Int?
  dirtyAtDispatch   Boolean       @default(false)
  baselineFiles     Json?
  /// 派发时的逐文件改动基线，用于扣除派发前已存在的未提交改动
  baselineDiff      Json?
  /// 运行期间产生的交付改动统计（文件数/行数，按顶层目录拆分）
  diffStat          Json?
  dispatchContext   Json?
  projectKey        String?       @db.VarChar(60)
  projectName       String?       @db.VarChar(120)
  deliveredArtifacts TaskArtifact[] @relation("ArtifactLastRun")
  task              Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId, startedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([platform, updatedAt(sort: Desc)])
  @@index([primaryAgent, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
}

/// 外部知识库（RAG）配置：单行配置，id 固定 default
model RagKnowledgeConfig {
  id              String    @id @default("default") @db.VarChar(32)
  enabled         Boolean   @default(false)
  baseUrl         String    @db.VarChar(300)
  /// AES-256-GCM 密文（含 iv/tag），不保存明文令牌
  tokenCipher     String?   @db.VarChar(1000)
  /// 只保存末 4 位用于展示
  tokenHint       String?   @db.VarChar(12)
  /// bridge = 自建检索桥；siyuan = 直连思源 API
  provider        String    @default("bridge") @db.VarChar(16)
  mode            String    @default("optional") @db.VarChar(12)
  timeoutMs       Int       @default(4000)
  agentSlugs      String[]  @default([])
  /// 直连模式下的思源笔记本白名单（box id），空表示不限制
  notebooks       String[]  @default([])
  pathPrefixes    String[]  @default([])
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  updatedBy       String?   @db.VarChar(120)
  lastTestAt      DateTime? @db.Timestamptz(3)
  lastTestStatus  String?   @db.VarChar(40)
  lastTestLatency Int?
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(80)
  passwordHash String        @db.VarChar(300)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TaskEvent {
  id             String         @id @default(uuid()) @db.Uuid
  taskRunId      String         @db.Uuid
  sequence       Int
  eventType      String         @db.VarChar(80)
  status         TaskRunStatus?
  stage          TaskRunStage
  agent          String         @db.VarChar(160)
  skills         String[]       @default([])
  summary        String         @db.VarChar(1000)
  evidence       Json?
  inputTokens    Int?
  outputTokens   Int?
  cachedTokens   Int?
  modelId        String?        @db.VarChar(160)
  idempotencyKey String         @unique @db.VarChar(200)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  taskRun        TaskRun        @relation(fields: [taskRunId], references: [id], onDelete: Restrict)

  @@unique([taskRunId, sequence])
  @@index([taskRunId, createdAt])
  @@index([agent, createdAt(sort: Desc)])
}

model RemoteApp {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  url       String   @db.VarChar(500)
  icon      String   @default("") @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

model RoleEvaluation {
  id          String    @id @default(uuid()) @db.Uuid
  agentSlug   String    @db.VarChar(120)
  agentName   String    @db.VarChar(120)
  projectKey  String    @default("digital-team") @db.VarChar(60)
  projectRoot String    @db.VarChar(300)
  tool        String    @db.VarChar(40)
  status      String    @default("running") @db.VarChar(20)
  sessionId   String?   @db.VarChar(200)
  pid         Int?
  reportPath  String    @db.VarChar(300)
  logPath     String    @db.VarChar(300)
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  // 评估同时登记到任务看板，这里保存对应任务 id
  taskId      String?   @db.Uuid

  @@index([projectKey, agentSlug, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([taskId])
}


model Task {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(120)
  brief       String         @db.VarChar(4000)
  acceptance  String         @db.VarChar(2000)
  agentSlug   String         @db.VarChar(120)
  priority    String         @default("P1") @db.VarChar(8)
  status      String         @default("DRAFT") @db.VarChar(24)
  readOnly    Boolean        @default(false)
  /// 是否在派发时检索外部知识库；关闭则本条任务不带知识片段
  useKnowledge Boolean       @default(true)
  mode        String         @default("auto") @db.VarChar(12)
  planPath    String?        @db.VarChar(300)
  planNote    String?        @db.VarChar(2000)
  dueAt       DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  reviewNote  String?        @db.VarChar(2000)
  reviewedAt  DateTime?      @db.Timestamptz(3)
  runs        TaskRun[]
  artifacts   TaskArtifact[]
  pendingDispatch Json?

  @@index([status, updatedAt(sort: Desc)])
  @@index([agentSlug, updatedAt(sort: Desc)])
}

model TaskArtifact {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  kind      String   @db.VarChar(16)
  source    String   @default("item") @db.VarChar(20)
  path      String   @db.VarChar(500)
  label     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lastRunId String?  @db.Uuid
  lastRun   TaskRun? @relation("ArtifactLastRun", fields: [lastRunId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([lastRunId])
}

model TaskImage {
  id        String   @id @default(uuid()) @db.Uuid
  path      String   @db.VarChar(300)
  label     String   @db.VarChar(200)
  mime      String   @db.VarChar(60)
  bytes     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model KnowledgePublication {
  id                String    @id @default(uuid()) @db.Uuid
  requestKey        String    @unique @db.VarChar(64)
  targetKey         String    @unique @db.VarChar(64)
  taskId            String?   @db.Uuid
  artifactId        String?   @db.Uuid
  createdBy         String    @db.Uuid
  title             String    @db.VarChar(120)
  markdown          String    @db.Text
  contentHash       String    @db.VarChar(64)
  sourceFingerprint String    @db.VarChar(64)
  notebookId        String    @db.VarChar(32)
  documentPath      String    @db.VarChar(500)
  status            String    @default("PREPARED") @db.VarChar(24)
  documentId        String?   @db.VarChar(32)
  error             String?   @db.VarChar(500)
  confirmedAt       DateTime? @db.Timestamptz(3)
  attemptedAt       DateTime? @db.Timestamptz(3)
  verifiedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
}

model TaskTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(60)
  title      String   @db.VarChar(120)
  brief      String   @db.VarChar(4000)
  acceptance String   @db.VarChar(2000) @default("")
  agentSlug  String   @db.VarChar(120)
  priority   String   @default("P1") @db.VarChar(8)
  readOnly   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([name])
  @@index([createdAt])
}
