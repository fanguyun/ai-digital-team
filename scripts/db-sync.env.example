# 复制为 scripts/db-sync.env 后填写（该文件已在 .gitignore 中）
# 不填也能跑 status --local / pull 之外的部分会提示缺配置

# 必填：SSH 免密登录 NAS 的方式
NAS_SSH=jonfan@192.168.31.150

# 可选：NAS 上的容器名与主库名
NAS_CONTAINER=postgres
SYNC_DB_NAME=personal_digital_team
SYNC_DB_OWNER=personal_digital_team

# 可选：NAS 上的超级用户名。留空则自动从容器环境变量 POSTGRES_USER 读取
# NAS_SUPERUSER=appuser

# 可选：本地 compose 服务名与超级用户名
LOCAL_SERVICE=postgres
LOCAL_SUPERUSER=personal_digital_team

# 可选：backups/database/ 里保留多少份 dump
SYNC_KEEP_BACKUPS=5
