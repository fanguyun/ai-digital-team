#!/usr/bin/env bash
set -u

script_dir="$(cd "$(dirname "$0")" && pwd)"
team_root="$(cd "$script_dir/.." && pwd)"
skills_root="${SKILLS_MANAGER_ROOT:-${HOME:-}/.skills-manager}"
cli="${SKILLS_MANAGER_CLI:-$skills_root/bin/skills-manager-cli}"
fixed_count=0
missing_count=0

find_candidate() {
  local target="$1"
  local skill_name="$2"
  local relative=""
  if [[ "$target" == */.skills-manager/* ]]; then
    relative="${target#*/.skills-manager/}"
    if [ -e "$skills_root/$relative/SKILL.md" ]; then
      printf '%s' "$skills_root/$relative"
      return 0
    fi
  fi
  if [ -e "$skills_root/skills/$skill_name/SKILL.md" ]; then
    printf '%s' "$skills_root/skills/$skill_name"
    return 0
  fi
  find "$skills_root/cache/repos" "$skills_root/skills" -type f -path "*/$skill_name/SKILL.md" -print -quit 2>/dev/null | sed 's#/SKILL.md$##'
}

install_missing() {
  local skill_name="$1"
  local reference="${SKILL_INSTALL_REFERENCE:-$skill_name}"
  if [ ! -x "$cli" ] && ! command -v skills-manager-cli >/dev/null 2>&1; then
    printf '未找到 Skills Manager CLI，无法自动安装 %s。\n' "$skill_name" >&2
    return 1
  fi
  printf 'Skill「%s」未安装。是否全局安装？[y/N] ' "$skill_name"
  read -r answer
  case "$answer" in
    y|Y|yes|YES)
      if [ -x "$cli" ]; then
        "$cli" skills install "$reference" --skills-root "$skills_root"
      else
        skills-manager-cli skills install "$reference" --skills-root "$skills_root"
      fi
      ;;
    *)
      printf '已跳过 %s。\n' "$skill_name"
      return 1
      ;;
  esac
}

while IFS= read -r -d '' link; do
  target="$(readlink "$link")"
  skill_name="$(basename "$link")"
  candidate="$(find_candidate "$target" "$skill_name")"
  if [ -n "$candidate" ] && [ -e "$candidate/SKILL.md" ]; then
    if [ "$target" != "$candidate" ]; then
      ln -sfn "$candidate" "$link"
      printf '已修复: %s -> %s\n' "${link#"$team_root"/}" "$candidate"
      fixed_count=$((fixed_count + 1))
    fi
    continue
  fi
  missing_count=$((missing_count + 1))
  if install_missing "$skill_name"; then
    candidate="$(find_candidate "$target" "$skill_name")"
    if [ -n "$candidate" ] && [ -e "$candidate/SKILL.md" ]; then
      ln -sfn "$candidate" "$link"
      printf '已安装并挂载: %s -> %s\n' "${link#"$team_root"/}" "$candidate"
      fixed_count=$((fixed_count + 1))
      missing_count=$((missing_count - 1))
    else
      printf '安装完成但仍找不到 %s 的 SKILL.md，请检查安装结果。\n' "$skill_name" >&2
    fi
  fi
done < <(find "$team_root/agents" -type l -path '*/.agents/skills/*' -print0 | sort -z)

printf '\n修复/挂载 %s 个，仍缺失 %s 个。\n' "$fixed_count" "$missing_count"
[ "$missing_count" -eq 0 ]
