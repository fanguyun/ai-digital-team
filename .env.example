# Copy to .env and replace the development-only token before writing events.
DATABASE_URL=postgresql://personal_digital_team:personal_digital_team@127.0.0.1:5433/personal_digital_team?schema=public
TEST_DATABASE_URL=postgresql://personal_digital_team:personal_digital_team@127.0.0.1:5433/personal_digital_team_test?schema=public
TASK_RUNTIME_WRITE_TOKEN=replace-with-a-long-random-local-token
TASK_RUNTIME_API_URL=http://127.0.0.1:8901/graphql
# Auto-read model and incremental token usage from the current Codex or
# DeepSeek Harness session. Set to off to only use explicit values below.
TASK_RUNTIME_TELEMETRY=auto
# Optional overrides. Explicit values take priority over automatic telemetry.
# TASK_RUNTIME_MODEL_ID=gpt-6.1-sol
# TASK_RUNTIME_INPUT_TOKENS=<incremental-count>
# TASK_RUNTIME_OUTPUT_TOKENS=<incremental-count>
# TASK_RUNTIME_CACHED_TOKENS=<incremental-count>
PRISMA_HIDE_UPDATE_MESSAGE=true
LOG_LEVEL=info
# Initial login. The password is hashed on first startup and is not stored in git.
AUTH_USERNAME=fan
AUTH_PASSWORD=replace-with-the-initial-password
