    "dsh",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fanguyun/ai-digital-team.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-skills": "./scripts/check-skills",
