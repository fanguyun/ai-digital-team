# 仅供部署侧填写；复制为同目录 .env（已被 Git 忽略），不要提交真实凭证。
# 思源地址必须从新容器内部可达；容器内的 127.0.0.1 不指向 NAS 宿主机。
SIYUAN_URL=http://nas-lan-ip:6806
SIYUAN_API_TOKEN=
# 笔记本 ID 白名单，逗号分隔；留空拒绝启动，不能填名称。
SIYUAN_NOTEBOOK_IDS=
# 独立密钥，至少 32 字符，必须与思源 Token 不同。
RAG_BRIDGE_TOKEN=
# 默认仅本机访问；跨主机前确认 NAS 局域网 IP 和防火墙规则，勿绑定公网。
RAG_BRIDGE_BIND_IP=127.0.0.1
